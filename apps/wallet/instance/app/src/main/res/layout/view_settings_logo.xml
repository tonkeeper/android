<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/offsetMedium"
    android:orientation="vertical">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        app:lottie_autoPlay="true"
        app:lottie_rawRes="@raw/keeper_logo"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/tt_firs_neue_medium"
        android:fontFeatureSettings="'ss07' on, 'ss09' on, 'ss17' on, 'ss18' on"
        android:text="@string/app_name"
        android:textSize="14sp"
        android:textColor="?attr/textPrimaryColor"
        android:gravity="center"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/tt_firs_neue_normal"
        android:fontFeatureSettings="'ss07' on, 'ss09' on, 'ss17' on, 'ss18' on"
        android:textSize="12sp"
        android:textColor="?attr/textSecondaryColor"
        android:gravity="center"/>

</androidx.appcompat.widget.LinearLayoutCompat>
<?xml version="1.0" encoding="utf-8"?>
<uikit.widget.SkeletonLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/offsetMedium">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_oval"
            android:backgroundTint="?attr/backgroundContentTintColor"
            android:scaleType="centerInside"
            android:src="@drawable/ic_percent_outline_28"
            android:tint="?attr/iconSecondaryColor" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/offsetMedium"
            android:layout_weight="1"
            android:orientation="vertical">

            <View
                android:layout_width="64dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_content"
                android:backgroundTint="?attr/backgroundContentTintColor" />

            <View
                android:layout_width="88dp"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_content"
                android:backgroundTint="?attr/backgroundContentTintColor" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <View
                android:layout_width="96dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_content"
                android:backgroundTint="?attr/backgroundContentTintColor" />

            <View
                android:layout_width="80dp"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_content"
                android:backgroundTint="?attr/backgroundContentTintColor" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</uikit.widget.SkeletonLayout>

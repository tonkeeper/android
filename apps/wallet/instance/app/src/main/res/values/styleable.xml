<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="PaymentTypeView">
        <attr name="android:title" format="string|reference"/>
        <attr name="android:subtitle" format="string|reference"/>
        <attr name="android:icon" format="reference"/>
        <attr name="android:checked" format="boolean"/>
    </declare-styleable>

    <declare-styleable name="CurrencyInputView">
        <attr name="android:title" format="string|reference"/>
        <attr name="disableInput" format="boolean"/>
        <attr name="android:gravity" format="integer"/>
        <attr name="valueScale" format="integer"/>
    </declare-styleable>

    <declare-styleable name="ReviewInputView">
        <attr name="android:title" format="string|reference"/>
    </declare-styleable>

    <declare-styleable name="LabelEditorView">
        <attr name="android:button" format="string|reference"/>
    </declare-styleable>

    <declare-styleable name="TransactionDetailView">
        <attr name="position"/>
        <attr name="android:title" format="string|reference"/>
        <attr name="android:orientation" format="integer"/>
    </declare-styleable>

    <declare-styleable name="MainRecyclerView">
        <attr name="android:topOffset" format="dimension|reference"/>
        <attr name="android:bottomOffset" format="dimension|reference"/>
    </declare-styleable>
</resources>
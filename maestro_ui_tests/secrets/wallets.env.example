# Wallet profiles for local Maestro QA runs. Copy to wallets.env (gitignored),
# fill in, never commit. tools/qa_run.sh --wallet <profile> maps
# WALLET_<PROFILE> / WALLET_<PROFILE>_ADDR onto WALLET_WITH_MONEY /
# WALLET_WITH_MONEY_ADDR, the variables the import steps and on-chain asserts use.
#
# Profiles (one seed per "fraction" of the product):
#   TON_ONLY   24-word TON mnemonic — imports as a legacy TON wallet (deeplinks,
#              TonConnect, legacy Fragment screens).
#   MULTICHAIN 12/24-word BIP39 mnemonic that is NOT a valid TON phrase — imports
#              straight into a multichain wallet.
#   TON_BIP39  24-word phrase valid under BOTH checksums — the import shows the
#              "Choose wallet" picker (steps/onboarding/confirm_import_selectors.yaml).
# Use small funded test wallets owned by the team; never a public phrase, never
# a customer's.

WALLET_TON_ONLY="word1 word2 ... word24"
WALLET_TON_ONLY_ADDR="UQ..."
WALLET_MULTICHAIN="word1 ... word12"
WALLET_MULTICHAIN_ADDR="UQ..."
WALLET_TON_BIP39="word1 ... word24"
WALLET_TON_BIP39_ADDR="UQ..."

# Passcode digit used by steps/password/enter_password.yaml (4 identical digits).
PASSWORD_KEY=5
# TonAPI bearer for scripts/api/** (service/** asserts).
MAESTRO_AUTH=""
# Recipient for send-to-self flows.
RECIEVE_WALLET="UQ..."

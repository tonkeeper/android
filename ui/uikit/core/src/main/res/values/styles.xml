<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Widget.BottomSheet" parent="@style/ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BottomSheet.Modal</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize|stateVisible</item>
    </style>

    <style name="Widget.BottomSheet.Modal" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bg_modal</item>
        <item name="android:maxWidth">640dp</item>
    </style>

    <style name="Base.Widget.App.Button" parent="android:Widget.Material.Button">
        <item name="backgroundTint">@null</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_height">@dimen/itemHeight</item>
        <item name="android:minHeight">@dimen/itemHeight</item>
    </style>

    <style name="Widget.App.Button" parent="Base.Widget.App.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/button_primary_foreground_selector</item>
    </style>

    <style name="Widget.App.Button.Secondary" parent="Base.Widget.App.Button">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/button_secondary_foreground_selector</item>
    </style>

    <style name="Widget.App.Button.Green" parent="Base.Widget.App.Button">
        <item name="android:background">@drawable/bg_button_green</item>
        <item name="android:textColor">@color/button_green_foreground_selector</item>
    </style>

    <style name="Widget.App.Button.Orange" parent="Base.Widget.App.Button">
        <item name="android:background">@drawable/bg_button_orange</item>
        <item name="android:textColor">?attr/buttonSecondaryForegroundColor</item>
    </style>

    <style name="Widget.App.Button.Medium" parent="Base.Widget.App.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:background">@drawable/bg_medium_button_primary</item>
        <item name="android:textColor">@color/button_primary_foreground_selector</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Label1</item>
        <item name="minHeight">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Widget.App.Button.Medium.Secondary" parent="Widget.App.Button.Medium">
        <item name="android:background">@drawable/bg_small_button_secondary</item>
        <item name="android:textColor">?attr/buttonSecondaryForegroundColor</item>
    </style>

    <style name="Widget.App.Button.Small" parent="Base.Widget.App.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/tertiaryHeight</item>
        <item name="android:minWidth">@dimen/tertiaryHeight</item>
        <item name="android:minHeight">@dimen/tertiaryHeight</item>
        <item name="android:background">@drawable/bg_small_button_primary</item>
        <item name="android:textColor">@color/button_primary_foreground_selector</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Label2</item>
        <item name="minHeight">0dp</item>
    </style>

    <style name="Widget.App.Button.Small.Tertiary" parent="Widget.App.Button.Small">
        <item name="android:background">@drawable/bg_small_tertiary_button_primary</item>
        <item name="android:textColor">@color/button_small_tertiary_foreground_selector</item>
    </style>

    <style name="Widget.App.Button.Small.Secondary" parent="Widget.App.Button.Small">
        <item name="android:background">@drawable/bg_small_button_secondary</item>
        <item name="android:textColor">?attr/buttonSecondaryForegroundColor</item>
    </style>

    <style name="Widget.App.Button.Tertiary" parent="android:Widget.Material.TextView">
        <item name="android:background">@drawable/bg_button_tertiary</item>
        <item name="android:textColor">?attr/buttonTertiaryForegroundColor</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Label2</item>
        <item name="android:paddingStart">@dimen/offsetMedium</item>
        <item name="android:paddingEnd">@dimen/offsetMedium</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.App.Tabs" parent="Widget.Design.TabLayout">
        <item name="tabTextAppearance">@style/Widget.App.Tabs.TextAppearance</item>
    </style>

    <style name="Widget.App.Tabs.TextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/tt_firs_neue_medium</item>
        <item name="android:fontFeatureSettings">"'ss07' on, 'ss09' on, 'ss17' on, 'ss18' on"</item>
        <item name="android:letterSpacing">0.005</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Dialog" parent="android:Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:background">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/Widget.Dialog.NoAnimation</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowLightStatusBar">@bool/use_light_system_bars</item>

        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/use_light_system_bars</item>

    </style>

    <style name="Widget.Dialog.NoAnimation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@null</item>
    </style>

    <style name="Widget.App.WordEditText" parent="android:Widget.Material.EditText">
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:inputType">textNoSuggestions</item>
        <item name="android:textCursorDrawable">@drawable/cursor</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:textAppearance">@style/TextAppearance.Body1</item>
        <item name="android:paddingTop">@dimen/offsetMedium</item>
        <item name="android:paddingBottom">@dimen/offsetMedium</item>
        <item name="android:paddingEnd">@dimen/offsetMedium</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:layout_marginTop">@dimen/offsetMedium</item>
    </style>

    <style name="Widget.App.TextTab" parent="android:Widget.Material.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/actionSize</item>
        <item name="android:textAppearance">@style/TextAppearance.Label2</item>
        <item name="android:textColor">?attr/textPrimaryColor</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="CircleImageView" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Battery">
        <item name="outerRadius">0dp</item>
        <item name="innerRadius">0dp</item>
        <item name="levelRadius">0dp</item>
        <item name="borderSize">0dp</item>
        <item name="capSize">0dp</item>
        <item name="capRadius">0dp</item>
        <item name="capOffset">0dp</item>
        <item name="iconSize">0dp</item>
    </style>

    <style name="Battery.VeryBig">
        <item name="android:layout_width">68dp</item>
        <item name="android:layout_height">114dp</item>
        <item name="outerRadius">16dp</item>
        <item name="innerRadius">12dp</item>
        <item name="levelRadius">8dp</item>
        <item name="borderSize">4dp</item>
        <item name="capSize">22dp</item>
        <item name="capRadius">14dp</item>
        <item name="capOffset">10dp</item>
        <item name="iconSize">48dp</item>
    </style>

    <style name="Battery.Big">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="outerRadius">6.5dp</item>
        <item name="innerRadius">5dp</item>
        <item name="levelRadius">3.5dp</item>
        <item name="borderSize">1.5dp</item>
        <item name="capSize">9dp</item>
        <item name="capRadius">10dp</item>
        <item name="capOffset">4dp</item>
        <item name="iconSize">22dp</item>
    </style>

    <style name="Battery.Medium">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="outerRadius">5dp</item>
        <item name="innerRadius">3.5dp</item>
        <item name="levelRadius">2dp</item>
        <item name="borderSize">1.5dp</item>
        <item name="capSize">7dp</item>
        <item name="capRadius">4dp</item>
        <item name="capOffset">3dp</item>
        <item name="iconSize">16dp</item>
    </style>

    <style name="Battery.Small">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="outerRadius">3.5dp</item>
        <item name="innerRadius">2.5dp</item>
        <item name="levelRadius">1.5dp</item>
        <item name="borderSize">1dp</item>
        <item name="capSize">2.5dp</item>
        <item name="capRadius">3dp</item>
        <item name="capOffset">2dp</item>
        <item name="iconSize">12dp</item>
    </style>
</resources>